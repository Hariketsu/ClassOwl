{
  "name": "classowl",
  "version": "0.1.0",
  "description": "面向小学教务的离线排课桌面应用（Electron + React + Python CP-SAT）",
  "license": "Apache-2.0",
  "author": "Hariketsu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hariketsu/ClassOwl.git"
  },
  "keywords": [
    "timetable",
    "scheduling",
    "education",
    "electron",
    "desktop",
    "cp-sat"
  ],
  "main": "electron/dist/main.js",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:app": "npm run build:electron && VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "npm --prefix frontend run build",
    "test": "npm --prefix frontend run test",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build:sidecar": "uv run pyinstaller --noconfirm --clean --distpath build/sidecar-dist --workpath build/sidecar-work electron/classowl.spec",
    "dist:mac": "npm run build:sidecar && npm run build:electron && electron-builder --mac dir dmg"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "electron": "^37.2.4",
    "electron-builder": "^26.0.12",
    "typescript": "^5.8.3"
  },
  "build": {
    "appId": "com.classowl.desktop",
    "productName": "ClassOwl",
    "directories": {
      "output": "dist",
      "buildResources": "build-resources"
    },
    "files": [
      "electron/dist/**/*",
      "frontend/dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/sidecar-dist/classowl",
        "to": "sidecar"
      }
    ],
    "mac": {
      "identity": "-",
      "target": [
        "dir",
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
